// Windows resources: the exe icon and its version information.
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     2,0,16,0
PRODUCTVERSION  2,0,16,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "All-in-1 Installer"
      VALUE "FileDescription",  "All-in-1 Installer - a full hotel server over SSH"
      VALUE "FileVersion",      "2.0.16"
      VALUE "InternalName",     "all-in-1-installer"
      VALUE "OriginalFilename", "all-in-1-installer.exe"
      VALUE "ProductName",      "All-in-1 Installer"
      VALUE "ProductVersion",   "2.0.16"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
