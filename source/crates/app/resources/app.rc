  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "All-in-1 Manager"
      VALUE "FileDescription",  "All-in-1 Manager - a full hotel server over SSH"
      VALUE "FileVersion",      "2.0.17"
      VALUE "InternalName",     "all-in-1-manager"
      VALUE "OriginalFilename", "all-in-1-manager.exe"
      VALUE "ProductName",      "All-in-1 Manager"
      VALUE "ProductVersion",   "2.0.17"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
